<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bonbon_human_state_fusion</name>
  <version>1.0.0</version>
  <description>
    Fuses bonbon_multi_person_tracker (identity/lifecycle), bonbon_affective_ai
    (emotion), bonbon_gesture (gesture), and bonbon_speaker_intelligence
    (speech) into one HumanState per person for the Behavior Engine. Does not
    re-derive emotion/gesture/speech — consumes their existing outputs.
  </description>
  <maintainer email="venka@bonbon-robotics.local">BonBon Robotics</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>bonbon_msgs</exec_depend>
  <exec_depend>bonbon_srvs</exec_depend>
  <exec_depend>python3-pyyaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
