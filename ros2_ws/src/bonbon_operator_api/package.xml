<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bonbon_operator_api</name>
  <version>0.1.0</version>
  <description>
    Operator Dashboard API for BonBon service robot.
    FastAPI-based REST + WebSocket backend for authorised operators to
    monitor, control, debug, configure, and supervise the robot safely.
  </description>
  <maintainer email="bonbon@robot.local">BonBon Robot</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <!-- ros2_bridge.py subscribes/calls real BonBon topics and services
       (SafetyState, NavigationStatus, ActuationStatus, TTSRequest,
       NavigateTo, CancelNavigation, GetNearestCharger) and the standard
       sensor_msgs/BatteryState + geometry_msgs/PoseStamped messages those
       interfaces use. -->
  <exec_depend>bonbon_msgs</exec_depend>
  <exec_depend>bonbon_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-pydantic</exec_depend>
  <!-- AI model registry / speech / Sarvam / perception / affective status
       endpoints (api/ai_model_status_api.py, websocket/ai_model_snapshots.py)
       import these two packages directly. -->
  <exec_depend>bonbon_ai_model_registry</exec_depend>
  <exec_depend>bonbon_sarvam_adapter</exec_depend>
  <!-- api/edge_ai_status_api.py's /vision-ai/status endpoint imports
       EdgeAIDashboardPublisher directly. -->
  <exec_depend>bonbon_edge_ai_runtime</exec_depend>

  <!-- pip install fastapi uvicorn[standard] PyJWT passlib[bcrypt] prometheus-client -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
