<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bonbon_patient_kiosk</name>
  <version>0.1.0</version>
  <description>
    Patient/customer-facing kiosk API for the BonBon service robot in a
    hospital reception deployment. FastAPI-based REST backend for patient
    history intake, appointment booking, queue/token issuance, RAG-grounded
    conversational wayfinding, and a staff-only facility map labeling tool.
    Fully separate from bonbon_operator_api (staff dashboard) and never
    bypasses the safety-gated navigation/LLM path.
  </description>
  <maintainer email="bonbon@robot.local">BonBon Robot</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <!-- ros2_bridge.py calls /llm/query, /navigation/navigate_to, publishes
       TTSRequest, and calls the SetPrivacyMode service. -->
  <exec_depend>bonbon_msgs</exec_depend>
  <exec_depend>bonbon_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-pydantic</exec_depend>

  <!-- pip install fastapi uvicorn[standard] PyJWT passlib[bcrypt] pycryptodome -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
