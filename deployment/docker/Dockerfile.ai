FROM ros:humble-ros-base-jammy

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive \
    ROS_DISTRO=humble \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip python3-colcon-common-extensions python3-rosdep \
    python3-yaml git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Pi-2 (Human AI) package set -- every package bonbon_human_ai_bringup's
# launch composition includes, plus their transitive bonbon_* exec_depends
# (bonbon_behavior_engine, bonbon_perception_efficiency), computed by
# grepping every package.xml's <exec_depend>bonbon_*</exec_depend> to a
# fixed point. Previously this image only copied bonbon_llm +
# bonbon_perception_ai + bonbon_msgs and never ran `rosdep install` at
# all (dependencies beyond a hardcoded python3-numpy were never actually
# resolved) -- neither would have supported the rest of Pi-2's real
# bringup composition. Both gaps are fixed here.
WORKDIR /opt/bonbon
COPY ros2_ws/src/bonbon_hal /opt/bonbon/ros2_ws/src/bonbon_hal
COPY ros2_ws/src/bonbon_speech /opt/bonbon/ros2_ws/src/bonbon_speech
COPY ros2_ws/src/bonbon_llm /opt/bonbon/ros2_ws/src/bonbon_llm
COPY ros2_ws/src/bonbon_vision /opt/bonbon/ros2_ws/src/bonbon_vision
COPY ros2_ws/src/bonbon_multi_person_tracker /opt/bonbon/ros2_ws/src/bonbon_multi_person_tracker
COPY ros2_ws/src/bonbon_object_intelligence /opt/bonbon/ros2_ws/src/bonbon_object_intelligence
COPY ros2_ws/src/bonbon_gesture /opt/bonbon/ros2_ws/src/bonbon_gesture
COPY ros2_ws/src/bonbon_affective_ai /opt/bonbon/ros2_ws/src/bonbon_affective_ai
COPY ros2_ws/src/bonbon_human_state_fusion /opt/bonbon/ros2_ws/src/bonbon_human_state_fusion
COPY ros2_ws/src/bonbon_speaker_intelligence /opt/bonbon/ros2_ws/src/bonbon_speaker_intelligence
COPY ros2_ws/src/bonbon_tts /opt/bonbon/ros2_ws/src/bonbon_tts
COPY ros2_ws/src/bonbon_perception_ai /opt/bonbon/ros2_ws/src/bonbon_perception_ai
COPY ros2_ws/src/bonbon_perception_efficiency /opt/bonbon/ros2_ws/src/bonbon_perception_efficiency
COPY ros2_ws/src/bonbon_behavior_engine /opt/bonbon/ros2_ws/src/bonbon_behavior_engine
COPY ros2_ws/src/bonbon_human_ai_bringup /opt/bonbon/ros2_ws/src/bonbon_human_ai_bringup
COPY ros2_ws/src/bonbon_distributed_safety /opt/bonbon/ros2_ws/src/bonbon_distributed_safety
COPY ros2_ws/src/bonbon_authority_manager /opt/bonbon/ros2_ws/src/bonbon_authority_manager
COPY ros2_ws/src/bonbon_msgs /opt/bonbon/ros2_ws/src/bonbon_msgs
COPY ros2_ws/src/bonbon_srvs /opt/bonbon/ros2_ws/src/bonbon_srvs
# NOTE: apt-get update must run again here -- the first RUN above deletes
# /var/lib/apt/lists/* at its end (standard image-size hygiene), so without
# a fresh update rosdep's apt-backed installs (python3-opencv, python3-smbus2)
# fail with "Unable to locate package" even though the packages genuinely
# exist in jammy's repos. Also restrict to --dependency-types=exec: several
# packages declare test_depends (python3-pytest-mock, ament_flake8, etc.)
# that either aren't real Debian package names or simply aren't needed to
# RUN a deployed node -- this is a runtime image, not a test environment.
# Found and fixed after the first real build attempt on Pi-2 hardware
# surfaced both failures.
RUN apt-get update && rosdep update && \
    rosdep install --from-paths ros2_ws/src --ignore-src -r -y --rosdistro humble \
        --dependency-types=exec --dependency-types=buildtool && \
    source /opt/ros/humble/setup.bash && colcon build --base-paths ros2_ws/src --merge-install && \
    rm -rf /var/lib/apt/lists/*

# Real Python backends (insightface/whisper/ollama/chromadb/mediapipe/etc.)
# -- none of these are rosdep-resolvable (they're not registered ROS
# system dependencies), and every bonbon_* package.xml only declares
# python3-numpy/python3-opencv. They're lazy-imported in code (degrade
# honestly to "backend unavailable" if missing, same pattern as every
# bonbon_hal driver's DriverFault("SDK_MISSING")) -- but that only helps
# if the alternative is "actually installed", not "never installed at
# all". requirements/pi2_requirements.txt is the authoritative manifest;
# see its header comment for the ARM64-specific choices (CPU-only torch,
# faster-whisper preferred, deepface deliberately excluded as redundant
# with insightface, faiss-cpu excluded since RAG defaults to chroma).
COPY requirements/pi2_requirements.txt /opt/bonbon/requirements/pi2_requirements.txt
RUN python3 -m pip install --no-cache-dir     -r /opt/bonbon/requirements/pi2_requirements.txt

RUN useradd --create-home --shell /bin/bash bonbon && chown -R bonbon:bonbon /opt/bonbon
USER bonbon
VOLUME ["/models"]
ENTRYPOINT ["/bin/bash", "-lc"]
CMD ["source /opt/ros/humble/setup.bash && source /opt/bonbon/install/setup.bash && ros2 launch bonbon_human_ai_bringup human_ai_bringup.launch.py"]
