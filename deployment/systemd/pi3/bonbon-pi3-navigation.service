[Unit]
Description=BonBon Pi-3 (Navigation/Motion/Safety) -- Nav2 + RTAB-Map localization
After=docker.service network-online.target bonbon-pi3-hal.service bonbon-pi3-base-controller.service
Wants=docker.service network-online.target
Requires=bonbon-pi3-hal.service bonbon-pi3-base-controller.service
Conflicts=bonbon-core.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/bonbon/bonbon.env
WorkingDirectory=/opt/bonbon/current
ExecStart=/usr/bin/docker compose -f docker-compose.pi3.yml up -d navigation
ExecStop=/usr/bin/docker compose -f docker-compose.pi3.yml stop navigation
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
