[Unit]
Description=BonBon Pi-3 (Navigation/Motion/Safety) -- safety_supervisor+safety_gate+watchdog+estop (CLASS-A, starts FIRST)
After=docker.service network-online.target
Wants=docker.service network-online.target

Conflicts=bonbon-core.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/bonbon/bonbon.env
WorkingDirectory=/opt/bonbon/current
ExecStart=/usr/bin/docker compose -f docker-compose.pi3.yml up -d safety
ExecStop=/usr/bin/docker compose -f docker-compose.pi3.yml stop safety
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
