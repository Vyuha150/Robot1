[Unit]
Description=BonBon Pi-3 (Navigation/Motion/Safety) -- lidar+motor+servo+stepper+estop+imu+battery
After=docker.service network-online.target bonbon-pi3-safety.service
Wants=docker.service network-online.target
Requires=bonbon-pi3-safety.service
Conflicts=bonbon-core.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/bonbon/bonbon.env
WorkingDirectory=/opt/bonbon/current
ExecStart=/usr/bin/docker compose -f docker-compose.pi3.yml up -d hal
ExecStop=/usr/bin/docker compose -f docker-compose.pi3.yml stop hal
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
