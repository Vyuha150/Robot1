[Unit]
Description=BonBon Actuation (servos, expressive motion — modular mode only)
# Actuation is safety-gated: it must not start before the safety supervisor
# (and HAL, which owns the servo serial driver) are up.
After=docker.service network-online.target bonbon-safety.service bonbon-hal.service
Wants=docker.service network-online.target
Requires=bonbon-safety.service bonbon-hal.service
Conflicts=bonbon-core.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/bonbon/bonbon.env
WorkingDirectory=/opt/bonbon/current
ExecStart=/usr/bin/docker compose -f docker-compose.robot.yml up -d actuation
ExecStop=/usr/bin/docker compose -f docker-compose.robot.yml stop actuation
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
