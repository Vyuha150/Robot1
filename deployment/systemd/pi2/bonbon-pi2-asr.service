[Unit]
Description=BonBon Pi-2 (Human AI) -- ASR/VAD (bonbon_speech, requires mic)
After=docker.service network-online.target bonbon-pi2-hal.service
Wants=docker.service network-online.target
Requires=bonbon-pi2-hal.service
Conflicts=bonbon-core.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/bonbon/bonbon.env
WorkingDirectory=/opt/bonbon/current
ExecStart=/usr/bin/docker compose -f docker-compose.pi2.yml up -d asr
ExecStop=/usr/bin/docker compose -f docker-compose.pi2.yml stop asr
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
