[Unit]
Description=BonBon Pi-2 (Human AI) -- cross-Pi heartbeat + authority (self_id=pi2)
After=docker.service network-online.target
Wants=docker.service network-online.target

Conflicts=bonbon-core.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/bonbon/bonbon.env
WorkingDirectory=/opt/bonbon/current
ExecStart=/usr/bin/docker compose -f docker-compose.pi2.yml up -d distributed-liveness
ExecStop=/usr/bin/docker compose -f docker-compose.pi2.yml stop distributed-liveness
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
