[Unit]
Description=BonBon Pi-2 (Human AI) -- local LLM (bonbon_llm, slowest to warm up)
After=docker.service network-online.target
Wants=docker.service network-online.target

Conflicts=bonbon-core.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/bonbon/bonbon.env
WorkingDirectory=/opt/bonbon/current
ExecStart=/usr/bin/docker compose -f docker-compose.pi2.yml up -d llm
ExecStop=/usr/bin/docker compose -f docker-compose.pi2.yml stop llm
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
