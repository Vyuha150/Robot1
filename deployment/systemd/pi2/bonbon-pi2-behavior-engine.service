[Unit]
Description=BonBon Pi-2 (Human AI) -- behavior proposal generation (bonbon_behavior_engine), sends proposals to Pi-3 (never commands motion directly)
After=docker.service network-online.target bonbon-pi2-llm.service
Wants=docker.service network-online.target

Conflicts=bonbon-core.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/bonbon/bonbon.env
WorkingDirectory=/opt/bonbon/current
ExecStart=/usr/bin/docker compose -f docker-compose.pi2.yml up -d behavior-engine
ExecStop=/usr/bin/docker compose -f docker-compose.pi2.yml stop behavior-engine
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
