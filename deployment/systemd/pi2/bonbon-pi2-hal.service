[Unit]
Description=BonBon Pi-2 (Human AI) -- OAK-D Lite + ReSpeaker XVF3800 + PAM8610 speaker
After=docker.service network-online.target
Wants=docker.service network-online.target

Conflicts=bonbon-core.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/bonbon/bonbon.env
WorkingDirectory=/opt/bonbon/current
ExecStart=/usr/bin/docker compose -f docker-compose.pi2.yml up -d hal
ExecStop=/usr/bin/docker compose -f docker-compose.pi2.yml stop hal
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
