[Unit]
Description=BonBon Behavior Engine (modular mode only)
After=docker.service network-online.target bonbon-safety.service bonbon-hal.service
Wants=docker.service network-online.target
Requires=bonbon-safety.service
Conflicts=bonbon-core.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/bonbon/bonbon.env
WorkingDirectory=/opt/bonbon/current
ExecStart=/usr/bin/docker compose -f docker-compose.robot.yml up -d behavior
ExecStop=/usr/bin/docker compose -f docker-compose.robot.yml stop behavior
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
